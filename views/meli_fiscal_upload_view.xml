<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_meli_fiscal_upload" model="ir.ui.view">
        <field name="name">account.move.form.meli.fiscal.upload</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_meli_upload_fiscal_pdf" type="object"
                        string="Upload Fiscal PDF to Mercado Libre"
                        groups="meli_oerp.group_mercadolibre_manager"
                        invisible="state != 'posted' or move_type != 'out_invoice'"/>
            </xpath>
        </field>
    </record>
</odoo>
